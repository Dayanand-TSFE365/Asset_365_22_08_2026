# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Python cache
__pycache__/
*.pyc

# Virtual Environments (highly recommended to exclude)
.venv/
venv/
ENV/
env/

# Environment variables / Secrets
# .env
# .env.*
# !.env.example

# IDE specific files
.vscode/
.idea/
*.swp

# OS specific files
.DS_Store
Thumbs.db

# FastAPI/Testing/Coverage
.pytest_cache/
.coverage
htmlcov/

# Local databases (e.g., SQLite)
*.db
*.sqlite3
